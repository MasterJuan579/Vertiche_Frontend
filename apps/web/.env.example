# Backend API base URL.
# - Local development: http://localhost:8080
# - Staging / Production EC2: http://52.4.219.206:8080
# The dashboard module reads this URL directly; it does NOT depend on Cognito
# to load KPIs and collection data. Cognito is only required for the shell layout.
VITE_API_URL=http://localhost:8080

# AWS Cognito (user pool with USER_PASSWORD_AUTH enabled).
# These are public client-side identifiers, not secrets.
VITE_COGNITO_REGION=us-east-1
VITE_COGNITO_USER_POOL_ID=us-east-1_xpzYpXlRS
VITE_COGNITO_CLIENT_ID=rkgnrkunq6777rmk37a6hev5
